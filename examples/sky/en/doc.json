 "facts": "facts.md",
 "lines": [
  {
   "text": "Sunlight looks white. So why is the sky blue?"
  },
  {
   "text": "White light is every colour of the rainbow, mixed."
  },
  {
   "text": "When it enters the air, it hits nitrogen and oxygen molecules and bounces off in every direction. That's scattering."
  },
  {
   "text": "The shorter the wave, the more it scatters."
  },
  {
   "text": "Blue light has a shorter wave than red, so it scatters more than five times as much."
  },
  {
   "text": "So wherever you look, the sky is full of scattered blue."
  },
  {
   "text": "Violet is even shorter. Why not a violet sky? Sunlight has less violet, and our eyes barely notice it."
  },
  {
   "text": "At sunset, light crosses much more air. The blue is scattered away on the way, leaving red and orange."
  },
  {
   "text": "The answer has a name: Rayleigh scattering."
  }
 ],
