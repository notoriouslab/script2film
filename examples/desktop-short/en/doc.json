 "lines": [
  {
   "text": "Rather not touch the terminal? Use Claude Code Desktop."
  },
  {
   "text": "Download the Claude desktop app and sign in. The Code tab needs a paid plan."
  },
  {
   "text": "Click Code at the top of the sidebar, pick Local, then open an empty folder."
  },
  {
   "text": "Then ask in one sentence: clone Script2Film and follow docs/INSTALL.md."
  },
  {
   "text": "It works through every step on its own, until it says you're ready."
  },
  {
   "text": "Then just say: make a template into a film. See you!"
  }
 ],
