 "lines": [
  {
   "text": "60/40: many call it the golden ratio of investing.",
   "tts": "Sixty-forty: many call it the golden ratio of investing."
  },
  {
   "text": "60% in stocks, 40% in bonds, rebalanced once a year.",
   "tts": "Sixty percent in stocks, forty in bonds, rebalanced once a year."
  },
  {
   "text": "In the 2008 crash, US stocks fell 37% in a year.",
   "tts": "In the 2008 crash, US stocks fell thirty-seven percent in a year."
  },
  {
   "text": "The same year, Treasury bonds rose 20%, and 60/40 lost only 14%.",
   "tts": "The same year, Treasury bonds rose twenty percent, and sixty-forty lost only fourteen."
  },
  {
   "text": "But in 2022 both fell together, and 60/40 lost 18%.",
   "tts": "But in 2022 both fell together, and sixty-forty lost eighteen percent."
  },
  {
   "text": "So it doesn't promise you won't lose. It makes most bad years a little shallower."
  },
  {
   "text": "The numbers are from NYU's public data. This is not investment advice."
  }
 ],
