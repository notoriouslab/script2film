# drama templates (tools/drama): the VE clips and music come with premade/; drama_cut.py writes .<cut stem>/ and <name>.mp4/.srt
examples/*/zh/clips/
examples/*/en/clips/
examples/*/zh/music.wav
examples/*/en/music.wav
examples/*/zh/.cut/
examples/*/en/.cut/
examples/*/zh/*.mp4
examples/*/en/*.mp4
examples/*/zh/*.srt
examples/*/en/*.srt
examples/*/score/
# logs of the TalkingPhoto runs and the host-look candidates
examples/*/tp_multi*.log
examples/*/*/tp_host.log
examples/*/look/
# VideoExpress actor ids belong to one account; the README says how to make your own
examples/*/masters.json

